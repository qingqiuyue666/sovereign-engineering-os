{
  "creative_brief": {
    "intent": "A fast sword slash production-prototype shot that verifies real Houdini cache output, ComfyUI image output, DaVinci probe evidence, package manifests, and review artifacts.",
    "look_targets": [
      "bright blade trail",
      "impact flash",
      "readable slash silhouette"
    ],
    "prototype_limitations": [
      "Uses the existing Houdini smoke/cache action as the physical slash-trail prototype path; no unsupported blade solver is claimed."
    ]
  },
  "dcc_chain": [
    {
      "adapter": "houdini_hython",
      "expected_outputs": [
        "smoke_cache.bgeo.sc",
        "smoke_cache_preview.exr",
        "smoke_cache_metadata.json",
        "smoke_cache_execution.log"
      ],
      "node_id": "houdini_sword_slash_cache"
    },
    {
      "adapter": "comfyui_local",
      "expected_outputs": [
        "comfyui_outputs/*.png"
      ],
      "node_id": "comfyui_sword_slash_image"
    },
    {
      "adapter": "davinci_resolve",
      "expected_outputs": [
        "davinci_project_probe.json"
      ],
      "node_id": "davinci_sword_slash_project_probe"
    }
  ],
  "package_policy": {
    "copy_policy": "artifact_refs_only",
    "runtime_outputs_committed": false
  },
  "project_template": "examples/projects/sword_slash_001_project_v1.json",
  "purpose": "Fast sword slash / energy trail / impact flash shot template for future live-action or anime-style compositing.",
  "schema_version": "seos.phase2_shot_template.v1",
  "shot_name": "sword_slash_001",
  "workflow": "examples/shots/sword_slash_001/workflow.json"
}
