{
  "policy_type": "protected_storage_interface_policy_v1",
  "version": "v1",
  "interface_contract_only": true,
  "no_real_storage_backend": true,
  "no_encryption_implementation": true,
  "no_key_material": true,
  "default_disabled": true,
  "live_write_rejected": true,
  "human_approval_required": true,
