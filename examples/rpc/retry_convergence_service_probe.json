        "allowed_tools": [
          "cline",
          "aider"
        ],
        "auto_apply": false,
        "enabled": true,
        "mode": "generate_patch_then_test"
      },
      "retry": {
        "backoff_seconds": 1,
        "enabled": true,
        "max_attempts": 2
      },
      "task_id": "TASK_RETRY_CONVERGENCE_SERVICE_PROBE"
    }
  }
}
