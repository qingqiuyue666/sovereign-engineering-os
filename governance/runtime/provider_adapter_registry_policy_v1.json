{
  "policy_type": "provider_adapter_registry_policy_v1",
  "version": "v1",
  "registry_descriptor_only": true,
  "no_live_adapters": true,
  "default_enabled_false": true,
  "deterministic_required": true,
  "no_provider_calls": true,
  "no_network_access": true,
  "forbidden_fields": [
    "raw_prompt",
    "raw_provider_response",
    "secret_value",
    "env_value"
  ],
  "required_fields": [
    "provider_id",
    "allowed_provider_types",
    "capability_boundary_ref",
    "context_firewall_binding_ref"
  ]
}
