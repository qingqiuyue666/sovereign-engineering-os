{
  "policy_type": "tool_risk_classifier_v1",
  "version": 1,
  "purpose": "Deterministically classify tool descriptors before any runtime admission.",
  "execution_allowed": false,
  "subprocess_allowed": false,
  "raw_command_allowed": false,
  "payload_argv_allowed": false,
  "command_line_allowed": false,
  "network_allowed": false,
  "browser_allowed": false,
  "provider_api_allowed": false,
  "credential_storage_allowed": false,
  "dcc_launch_allowed": false,
  "comfyui_launch_allowed": false,
  "production_autonomy_allowed": false,
  "risk_classes": [
    "READ_ONLY",
    "LOCAL_FILE_READ",
    "LOCAL_FILE_WRITE",
    "PROCESS_LAUNCH",
    "NETWORK_ACCESS",
    "BROWSER_CONTROL",
    "PROVIDER_API",
    "CREDENTIAL_TOUCHING",
    "MCP_TOOL",
    "DCC_CONTROL",
    "COMFYUI_EXECUTION",
    "RENDER_EXECUTION",
    "MODEL_EXECUTION",
    "PLUGIN_EXECUTION",
    "HIGH_RISK"
  ],
  "high_risk_production_admission_allowed": false,
  "unknown_capability_policy": "HIGH_RISK",
  "missing_source_type_policy": "HIGH_RISK",
  "plugin_execution_requires_sandbox_strategy": true
}
