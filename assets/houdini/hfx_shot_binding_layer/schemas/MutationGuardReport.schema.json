{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "blocked_claims": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "checks": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "forbidden_output_roots": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "package_root": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "release_roots_guarded": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema_type": {
      "const": "MutationGuardReport"
    },
    "sequence_id": {
      "type": "string"
    },
    "shot_id": {
      "type": "string"
    },
    "source_release_hip_hash_checks": {
      "items": {
        "type": "object"
      },
      "type": "array"
