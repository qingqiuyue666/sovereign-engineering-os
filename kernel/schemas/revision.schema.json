{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:seos:v11-slice1:revision",
  "artifact_type": "Revision",
  "schema_version": "v11-slice1",
  "source_ref": "v11 §23.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision_id",
    "parent_revision_id",
    "project_id",
    "task_id",
    "state",
    "root_hash",
    "snapshot_root_id",
    "intent_id",
    "originating_context_artifact_id",
    "approval_id",
    "logical_sequence_at_seal",
    "version_tuple_hash",
    "taint_set",
    "created_at",
    "sealed_at"
  ],
  "properties": {
    "revision_id": {"type": "string", "minLength": 1},
    "parent_revision_id": {"type": ["string", "null"]},
    "project_id": {"type": "string"},
    "task_id": {"type": "string"},
    "state": {"type": "string", "enum": ["pending", "sealed", "abandoned"]},
    "root_hash": {"type": "string"},
    "snapshot_root_id": {"type": "string"},
    "intent_id": {"type": "string"},
    "originating_context_artifact_id": {"type": "string"},
    "approval_id": {"type": "string"},
    "logical_sequence_at_seal": {"type": "integer", "minimum": 0},
    "version_tuple_hash": {"type": "string"},
    "taint_set": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "sealed_at": {"type": ["string", "null"], "format": "date-time"},
    "abandonment_reason": {"type": "string"},
    "recovery_note": {"type": "string"}
  }
}
