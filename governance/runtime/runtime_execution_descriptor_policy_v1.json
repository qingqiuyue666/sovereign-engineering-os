{
  "policy_type": "runtime_execution_descriptor_policy_v1",
  "version": "v1",
  "dry_run_only": true,
  "provider_execution_allowed": false,
  "network_access_allowed": false,
  "production_autonomy_allowed": false,
  "deterministic_required": true,
  "no_provider_calls": true,
  "no_network_access": true,
  "no_sqlite": true,
  "no_file_mutation": true,
  "required_string_fields": [
    "task_id",
    "run_id",
    "execution_id",
    "stage",
    "policy_version",
    "code_version"
  ],
  "required_digest_fields": [
    "input_digest",
    "task_manifest_digest",
    "operator_intent_digest"
  ],
  "required_bool_fields": [
    "dry_run",
    "provider_enabled",
    "network_access",
    "production_autonomy"
  ],
  "required_bool_values": {
    "dry_run": true,
    "provider_enabled": false,
    "network_access": false,
    "production_autonomy": false
  },
  "forbidden_fields": [
    "raw_prompt",
    "raw_provider_response",
    "secret_value",
    "env_value",
    "provider_api_key",
    "live_network_target",
    "autonomy_directive"
  ],
  "digest_format_required": "sha256:",
  "receipt_required_fields": [
    "accepted",
    "failures",
    "execution_id",
    "task_id",
    "run_id",
    "policy_version",
    "code_version",
    "descriptor_digest"
  ]
}
