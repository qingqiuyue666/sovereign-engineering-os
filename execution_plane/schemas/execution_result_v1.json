{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "enum": [
        "fake_dcc",
        "houdini_hython"
      ],
      "type": "string"
    },
    "ended_at": {
      "format": "date-time",
      "type": "string"
    },
    "evidence_manifest_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "exit_code": {
      "type": "integer"
    },
    "failure_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_root": {
      "minLength": 1,
      "type": "string"
    },
    "outputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "relative_path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "minLength": 71,
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "relative_path",
          "size_bytes",
          "sha256"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "permit_id": {
      "minLength": 1,
      "type": "string"
    },
    "policy_blocks": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "run_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "seos_execution_result_v1",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "type": "string"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "BLOCKED"
      ],
      "type": "string"
    },
    "stderr_digest": {
      "minLength": 71,
      "type": "string"
    },
    "stdout_digest": {
      "minLength": 71,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "permit_id",
    "run_id",
    "adapter",
    "started_at",
    "ended_at",
    "exit_code",
    "status",
    "output_root",
    "outputs",
    "stdout_digest",
    "stderr_digest",
    "failure_summary",
    "policy_blocks",
    "evidence_manifest_path"
  ],
  "title": "SEOS Execution Result V1",
  "type": "object"
}

