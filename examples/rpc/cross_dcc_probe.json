{
  "id": "cross_dcc_probe_v1",
  "jsonrpc": "2.0",
  "method": "workflow.invoke",
  "params": {
    "nodes": [
      {
        "action": "smoke_generate_file",
        "adapter": "fake_dcc",
        "node_id": "fake_probe",
        "payload": {
          "content": "cross dcc probe\n",
          "output_path": "fake_probe.txt"
        }
      },
      {
        "action": "smoke_cache_test",
        "adapter": "houdini_hython",
        "node_id": "houdini_probe"
      },
      {
        "action": "service_probe",
        "adapter": "comfyui_local",
        "node_id": "comfyui_probe"
      },
      {
        "action": "project_probe",
        "adapter": "davinci_resolve",
        "node_id": "davinci_probe"
      }
    ],
    "output_root": "work/rpc/cross_dcc_probe",
    "runtime_token": {
      "auto_provision": {
        "allowed_adapters": [
          "comfyui_local",
          "davinci_resolve"
        ],
        "enabled": true,
        "heartbeat_interval_seconds": 1,
        "max_wait_seconds": 1
      },
      "concurrency": {
        "max_global_jobs": 3,
        "max_per_adapter_jobs": {
          "comfyui_local": 2,
          "davinci_resolve": 1,
          "fake_dcc": 1,
          "houdini_hython": 1
        }
      },
      "expires_at": "2099-01-01T00:00:00Z",
      "max_files": 100,
      "max_output_bytes": 104857600,
      "max_runtime_seconds": 60,
      "operator_approval_id": "RCPT_CROSS_DCC_PROBE",
      "patch_repair": {
        "allowed_tools": [
          "cline",
          "aider"
        ],
        "auto_apply": false,
        "enabled": true,
        "mode": "generate_patch_then_test"
      },
      "retry": {
        "backoff_seconds": 1,
        "enabled": true,
        "max_attempts": 2
      },
      "task_id": "TASK_CROSS_DCC_PROBE"
    },
    "workflow_id": "cross_dcc_probe_v1"
  }
}
