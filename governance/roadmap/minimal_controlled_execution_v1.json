  "status": "ROADMAP_ONLY",
  "next_target_state": "MINIMAL_CONTROLLED_EXECUTION_READY",
  "implementation_allowed_in_this_pr": false,
  "contract_only_marker": "MINIMAL_CONTROLLED_EXECUTION_CONTRACT_ONLY_V1",
  "execution_performed": false,
  "runner_implemented": false,
  "allowlisted_runner_implemented": false,
  "allowed_command_set": [
    "git_status_short",
    "git_diff_check"
