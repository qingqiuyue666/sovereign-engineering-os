{
  "$id": "sovereign-engineering-os://assets/houdini/hfx_comp_automation_layer/hfx_nuke_comp_template.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Default schema for Nuke comp template contracts.",
  "properties": {
    "color_management_ref": {
      "description": "OCIO or ACES contract reference.",
      "minLength": 1,
      "type": "string"
    },
    "contract_layer": {
      "const": "hfx_comp_automation_layer",
      "description": "Owning HFX contract layer.",
      "minLength": 1,
      "type": "string"
    },
    "contract_status": {
      "description": "Lifecycle state for the contract payload.",
      "enum": [
        "draft",
        "ready_for_review",
        "approved",
        "blocked"
      ],
      "minLength": 1,
      "type": "string"
    },
    "final_pixel_claim": {
      "const": false,
      "description": "Must remain false while this scaffold is not producing final pixels.",
      "type": "boolean"
    },
    "input_layers": {
      "description": "Logical render layer references.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "Human-readable slot or artifact name.",
            "minLength": 1,
            "type": "string"
          },
          "ref": {
            "description": "Logical reference to a contract artifact.",
            "minLength": 1,
            "type": "string"
          },
          "required": {
            "default": true,
            "description": "Whether the referenced artifact is required.",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "ref"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "notes": {
      "description": "Optional governance notes.",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "output_nodes": {
      "description": "Named output node contracts.",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": "hfx-nuke-comp-template-v1",
      "description": "Exact schema version for this contract payload.",
      "minLength": 1,
      "type": "string"
    },
    "script_template_ref": {
      "description": "Logical Nuke script template reference.",
      "minLength": 1,
      "type": "string"
    },
    "shot_id": {
      "description": "Shot identifier.",
      "minLength": 1,
      "type": "string"
    },
    "template_id": {
      "description": "Stable Nuke template identifier.",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "contract_layer",
    "contract_status",
    "final_pixel_claim",
    "template_id",
    "shot_id",
    "script_template_ref",
    "input_layers"
  ],
  "title": "HFX Nuke Comp Template Schema",
  "type": "object"
}
