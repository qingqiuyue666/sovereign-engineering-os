{
  "$id": "sovereign-engineering-os://assets/houdini/hfx_review_dailies_layer/hfx_dailies_manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Default schema for daily review submission manifests.",
  "properties": {
    "color_pipeline_ref": {
      "description": "Color-management contract reference.",
      "minLength": 1,
      "type": "string"
    },
    "contract_layer": {
      "const": "hfx_review_dailies_layer",
      "description": "Owning HFX contract layer.",
      "minLength": 1,
      "type": "string"
    },
    "contract_status": {
      "description": "Lifecycle state for the contract payload.",
      "enum": [
        "draft",
        "ready_for_review",
        "approved",
        "blocked"
      ],
      "minLength": 1,
      "type": "string"
    },
    "final_pixel_claim": {
      "const": false,
      "description": "Must remain false while this scaffold is not producing final pixels.",
      "type": "boolean"
    },
    "frame_range": {
      "additionalProperties": false,
      "description": "Submitted frame range.",
      "properties": {
        "end": {
          "description": "Last frame in the governed range.",
          "minimum": 1,
          "type": "integer"
        },
        "start": {
          "description": "First frame in the governed range.",
          "minimum": 1,
          "type": "integer"
        },
        "step": {
          "default": 1,
          "description": "Frame increment.",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end",
        "step"
      ],
      "type": "object"
    },
    "media_ref": {
      "description": "Logical review media reference.",
      "minLength": 1,
      "type": "string"
    },
    "notes": {
      "description": "Optional governance notes.",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "qc_checklist_ref": {
      "description": "QC checklist contract reference.",
      "minLength": 1,
      "type": "string"
    },
    "review_id": {
      "description": "Stable dailies review identifier.",
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": "hfx-dailies-manifest-v1",
      "description": "Exact schema version for this contract payload.",
      "minLength": 1,
      "type": "string"
    },
    "shot_id": {
      "description": "Shot identifier.",
      "minLength": 1,
      "type": "string"
    },
    "submitted_by": {
      "description": "Submitting artist or automation.",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "contract_layer",
    "contract_status",
    "final_pixel_claim",
    "review_id",
    "shot_id",
    "submitted_by",
    "media_ref",
    "qc_checklist_ref"
  ],
  "title": "HFX Dailies Manifest Schema",
  "type": "object"
}
