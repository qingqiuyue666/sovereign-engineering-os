{
  "creative_brief": {
    "intent": "A compact energy-impact proof shot that verifies real Houdini cache output, ComfyUI image output, DaVinci probe evidence, package manifests, and review artifacts.",
    "look_targets": [
      "procedural energy burst",
      "controlled smoke cache preview",
      "single generated concept image"
    ]
  },
  "dcc_chain": [
    {
      "adapter": "houdini_hython",
      "expected_outputs": [
        "smoke_cache.bgeo.sc",
        "smoke_cache_preview.exr",
        "smoke_cache_metadata.json",
        "smoke_cache_execution.log"
      ],
      "node_id": "houdini_energy_smoke"
    },
    {
      "adapter": "comfyui_local",
      "expected_outputs": [
        "comfyui_outputs/*.png"
      ],
      "node_id": "comfyui_energy_image"
    },
    {
      "adapter": "davinci_resolve",
      "expected_outputs": [
        "davinci_project_probe.json"
      ],
      "node_id": "davinci_energy_project_probe"
    }
  ],
  "package_policy": {
    "copy_policy": "artifact_refs_only",
    "runtime_outputs_committed": false
  },
  "project_template": "examples/projects/energy_impact_project_v1.json",
  "schema_version": "seos.energy_impact_shot_template.v1",
  "shot_name": "energy_impact_001",
  "workflow": "examples/shots/energy_impact_001/workflow.json"
}
