{
  "policy_type": "replay_diff_policy_v1",
  "version": "v1",
  "descriptor_only": true,
  "deterministic_required": true,
  "no_provider_calls": true,
  "no_network_access": true,
  "no_sqlite": true,
  "no_file_mutation": true,
  "forbidden_fields": [
    "raw_prompt",
    "raw_provider_response",
    "secret_value",
    "env_value"
  ],
  "required_fields": [
    "expected_output_digest",
    "actual_output_digest",
    "policy_version",
    "code_version",
    "bound_version_tuple"
  ],
  "digest_format_required": "sha256:"
}
