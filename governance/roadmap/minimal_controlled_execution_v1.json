      "allowed_verifier": "git_status_short_contract_verifier",
      "registry_version": "minimal_controlled_execution_registry_v1"
    },
    "git_diff_check": {
      "fixed_argv": ["git", "diff", "--check"],
      "command_class": "REPOSITORY_READ_ONLY_CHECK",
      "read_only_expectation": true,
      "allowed_verifier": "git_diff_check_contract_verifier",
      "registry_version": "minimal_controlled_execution_registry_v1"
    }
  },
  "deferred_future_command_ids": [
    "unittest_discover_tests",
    "make_ci"
  ],
  "explicit_forbidden_commands": [
    "arbitrary shell",
    "arbitrary argv",
    "arbitrary cwd/env/path/executable/timeout",
    "command_line",
    "command",
    "payload-provided executable",
    "payload-provided cwd/env/path",
    "payload-provided timeout",
    "subprocess",
    "runner",
    "launcher",
    "CLI entrypoint",
    "daemon",
    "scheduler",
    "task graph execution",
    "auto re-execution",
    "network calls",
    "browser control",
    "provider API",
    "credentials",
    "DCC launch",
    "ComfyUI launch",
    "MCP execution",
    "CLI plugin execution",
    "package install",
    "file deletion",
    "asset mutation"
  ],
  "contract_only_allowed_types": [
    "ExecutionRequest",
    "ExecutionPolicyDecision",
    "ExecutionReceipt",
    "ExecutionFailureBundle",
    "ExecutionSnapshotRef",
    "ExecutionVerifierInput"
  ],
  "required_execution_closure_components": [
    "TaskIntent",
    "PolicyDecision",
    "CommandEnvelope",
    "AdmissionDecision",
    "ApprovalToken if required",
    "AllowlistedRunner",
    "ExecutionReceipt",
    "Verifier",
    "JournalRecord",
    "FailureBundle",
    "OperatorTaskSnapshot"
  ],
  "receipt_requirements": [
    "command_id",
    "allowlist_id",
    "started_at",
    "ended_at",
    "exit_code",
    "stdout_digest",
    "stderr_digest",
    "output_truncation_policy",
    "working_tree_before",
    "working_tree_after",
    "verifier_result",
    "journal_entry_id",
    "receipt_hash",
    "execution_performed=false"
  ],
  "failure_bundle_requirements": [
    "failure_id",
    "failed_step",
    "exit_code",
    "stderr_digest",
    "stdout_digest",
    "verifier_failure",
    "rollback_required",
    "human_review_required",
    "evidence_refs",
    "execution_performed=false"
  ],
  "non_goals": [
    "no general shell",
    "no DCC control",
    "no ComfyUI execution",
    "no provider API",
    "no browser automation",
    "no package install",
    "no GUI",
    "no autonomous production action",
    "no dry-run abstraction layer"
  ],
  "admission_criteria": [
    "Commands must be selected by command_id from the allowlist.",
    "Payloads must not supply executable, argv, cwd, env, path, or timeout.",
    "Contract-only V1 must reject unittest_discover_tests and make_ci as deferred future command IDs.",
    "Policy decisions must carry policy version, registry version/hash, rejection reasons, and forbidden-surface flags set false.",
    "Receipts, failures, snapshots, and verifier inputs must carry execution_performed=false.",
    "Outputs must be recorded by digest with truncation policy.",
    "Verifier result and journal entry ID are required before closure.",
    "Failures must produce a FailureBundle with human review status."
  ]
}
