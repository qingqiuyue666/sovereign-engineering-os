{
  "policy_type": "repository_hygiene_policy_v1",
  "version": "v1",
  "forbidden_paths": [".env", "secrets/", "credentials/", "node_modules/", ".venv/", "__pycache__/"],
  "forbidden_suffixes": [".pem", ".key", ".p12", ".pfx", ".sqlite", ".db", ".log", ".dump"],
  "secret_scanning_required": true,
  "destructive_cleanup_allowed": false
}
