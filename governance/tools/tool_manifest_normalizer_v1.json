{
  "policy_type": "tool_manifest_normalizer_v1",
  "baseline": "CONTROLLED_DRY_RUN_RUNTIME_READY",
  "target_state": "TOOL_INGESTION_DRY_RUN_READY",
  "normalization_only": true,
  "execution_allowed": false,
  "direct_execution_allowed": false,
  "runtime_integration_allowed": false,
  "subprocess_allowed": false,
  "network_allowed": false,
  "browser_allowed": false,
  "provider_api_allowed": false,
  "credential_storage_allowed": false,
  "mcp_execution_allowed": false,
  "cli_execution_allowed": false,
  "plugin_execution_allowed": false,
  "dcc_launch_allowed": false,
  "comfyui_launch_allowed": false,
  "production_autonomy_allowed": false,
  "supported_source_types": [
    "MCP_SERVER",
    "MCP_TOOL",
    "CLI_TOOL",
    "LOCAL_SCRIPT",
    "API_ADAPTER",
    "DCC_APP",
    "DCC_PLUGIN",
    "COMFYUI_WORKFLOW",
    "GITHUB_REPO",
    "WASM_PLUGIN",
    "BROWSER_AUTOMATION_TOOL",
    "MODEL_RUNTIME",
    "RENDER_TOOL",
    "UNKNOWN"
  ],
  "forbidden_fields": [
    "COMMAND",
    "RAW_COMMAND",
    "COMMAND_LINE",
    "ARGV",
    "ARGS",
    "SHELL",
    "SCRIPT",
    "BASH",
    "PYTHON_CODE",
    "EXECUTABLE",
    "EXECUTABLE_PATH",
    "WORKDIR",
    "CWD",
    "ENV",
    "ENVIRONMENT",
    "PATH",
    "PATH_OVERRIDE",
    "CREDENTIAL",
    "SECRET",
    "TOKEN_VALUE",
    "API_KEY",
    "PASSWORD",
    "PRIVATE_KEY",
    "TIMEOUT"
  ],
  "metadata_only_references": [
    "network_scope",
    "source_ref",
    "provider_scope",
    "dcc_scope",
    "model_scope",
    "browser_scope",
    "plugin_scope"
  ],
  "content_hash_excludes": [
    "normalized_at"
  ],
  "standard_library_only": true
}
