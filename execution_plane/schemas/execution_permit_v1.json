{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_action": {
      "enum": [
        "smoke_generate_file",
        "version_probe",
        "smoke_cache_test",
        "geometry_cache_test",
        "hip_open_validate",
        "houdini_generate_geometry_cache",
        "service_probe",
        "submit_workflow",
        "poll_history",
        "collect_outputs",
        "project_probe",
        "timeline_export_probe",
        "render_preset_test"
      ],
      "type": "string"
    },
    "allowed_adapter": {
      "enum": [
        "fake_dcc",
        "houdini_hython",
        "comfyui_local",
        "davinci_resolve"
      ],
      "type": "string"
    },
    "allowed_input_roots": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "allowed_output_root": {
      "minLength": 1,
      "type": "string"
    },
    "auto_provision": {
      "additionalProperties": false,
      "properties": {
        "allowed_adapters": {
          "items": {
            "enum": [
              "fake_dcc",
              "houdini_hython",
              "comfyui_local",
              "davinci_resolve"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "enabled": {
          "type": "boolean"
        },
        "heartbeat_interval_seconds": {
          "minimum": 1,
          "type": "integer"
        },
        "max_wait_seconds": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "enabled",
        "allowed_adapters",
        "max_wait_seconds",
        "heartbeat_interval_seconds"
      ],
      "type": "object"
    },
    "concurrency": {
      "additionalProperties": false,
      "properties": {
        "max_global_jobs": {
          "minimum": 1,
          "type": "integer"
        },
        "max_per_adapter_jobs": {
          "additionalProperties": {
            "minimum": 1,
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "fake_dcc",
              "houdini_hython",
              "comfyui_local",
              "davinci_resolve"
            ]
          },
          "type": "object"
        }
      },
      "required": [
        "max_global_jobs",
        "max_per_adapter_jobs"
      ],
      "type": "object"
    },
    "created_at": {
      "format": "date-time",
      "type": "string"
    },
    "destructive_action_allowed": {
      "const": false,
      "type": "boolean"
    },
    "evidence_required": {
      "const": true,
      "type": "boolean"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "max_files": {
      "minimum": 1,
      "type": "integer"
    },
    "max_output_bytes": {
      "minimum": 1,
      "type": "integer"
    },
    "max_runtime_seconds": {
      "minimum": 1,
      "type": "integer"
    },
    "network_allowed": {
      "const": false,
      "type": "boolean"
    },
    "operator_approval_id": {
      "minLength": 1,
      "type": "string"
    },
    "patch_repair": {
      "additionalProperties": false,
      "properties": {
        "allowed_tools": {
          "items": {
            "enum": [
              "cline",
              "aider"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "auto_apply": {
          "const": false,
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "report_only",
            "generate_patch_then_test"
          ],
          "type": "string"
        }
      },
      "required": [
        "enabled",
        "mode",
        "allowed_tools",
        "auto_apply"
      ],
      "type": "object"
    },
    "permit_digest": {
      "minLength": 71,
      "type": "string"
    },
    "permit_id": {
      "minLength": 1,
      "type": "string"
    },
    "policy_version": {
      "const": "seos_execution_policy_v1",
      "type": "string"
    },
    "required_outputs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "kind",
          "path"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "retry": {
      "additionalProperties": false,
      "properties": {
        "backoff_seconds": {
          "minimum": 0,
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        },
        "max_attempts": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "enabled",
        "max_attempts",
        "backoff_seconds"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "seos_execution_permit_v1",
      "type": "string"
    },
    "task_id": {
      "minLength": 1,
      "type": "string"
    },
    "write_scope": {
      "const": "single_output_directory",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "permit_id",
    "task_id",
    "operator_approval_id",
    "created_at",
    "expires_at",
    "allowed_adapter",
    "allowed_action",
    "allowed_input_roots",
    "allowed_output_root",
    "write_scope",
    "network_allowed",
    "destructive_action_allowed",
    "max_runtime_seconds",
    "max_output_bytes",
    "max_files",
    "required_outputs",
    "evidence_required",
    "policy_version",
    "permit_digest"
  ],
  "title": "SEOS Execution Permit V1",
  "type": "object"
}
