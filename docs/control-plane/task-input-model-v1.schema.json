{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/qqyqqyqqy666-wq/sovereign-engineering-os/docs/control-plane/task-input-model-v1.schema.json",
  "title": "AI Agent Control Plane Task Input V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "title",
    "task_type",
    "risk_hints",
    "requested_action",
    "allowed_paths",
    "expected_checks",
    "evidence_requirements"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^ACP-TASK-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 8
    },
    "task_type": {
      "type": "string",
      "enum": [
        "documentation",
        "code",
        "test",
        "ci",
        "audit",
        "external_tool",
        "human_only",
        "forbidden"
      ]
    },
    "risk_hints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high",
          "forbidden",
          "touches_docs",
          "touches_code",
          "touches_tests",
          "touches_ci",
          "external_side_effect",
          "secret_risk",
          "destructive_risk",
          "deploy_risk",
          "merge_release_tag_risk",
          "paid_api_risk",
          "untrusted_tool_instruction"
        ]
      }
    },
    "requested_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "command_intent",
        "external_side_effect_requested"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 8
        },
        "command_intent": {
          "type": "string",
          "minLength": 3
        },
        "external_side_effect_requested": {
          "type": "boolean"
        }
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._/-]+$"
      }
    },
    "expected_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "classifier_output",
          "policy_decision",
          "command_summary",
          "file_paths",
          "check_result",
          "ledger_entry",
          "failure_or_blocker_record",
          "resume_point",
          "rollback_note",
          "external_actor",
          "external_artifact"
        ]
      }
    }
  }
}

