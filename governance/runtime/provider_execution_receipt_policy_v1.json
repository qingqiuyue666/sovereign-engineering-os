{
  "policy_type": "provider_execution_receipt_policy_v1",
  "version": "v1",
  "sealed_descriptor_only": true,
  "no_raw_prompt": true,
  "no_raw_response": true,
  "deterministic_required": true,
  "no_provider_calls": true,
  "no_network_access": true,
  "forbidden_fields": [
    "raw_prompt",
    "raw_provider_response",
    "secret_value",
    "env_value"
  ],
  "required_fields": [
    "provider_id",
    "request_digest",
    "response_digest",
    "authorization_digest",
    "policy_version",
    "code_version",
    "post_run_health_digest",
    "quarantine_ref"
  ],
  "digest_format_required": "sha256:"
}
