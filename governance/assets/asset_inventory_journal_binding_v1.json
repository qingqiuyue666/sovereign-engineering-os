{
  "policy_type": "asset_inventory_journal_binding_v1",
  "version": 1,
  "purpose": "Bind minimal asset inventory scans to append-only SQLite WAL evidence events.",
  "uses_minimal_asset_inventory": true,
  "uses_sqlite_wal_mode": true,
  "compatible_with_command_wal_tables": false,
  "adapter_event_type": "ASSET_INVENTORY_SCAN",
  "append_only": true,
  "update_delete_mutation_apis_allowed": false,
  "explicit_roots_only": true,
  "home_root_allowed": false,
  "filesystem_root_allowed": false,
  "path_traversal_allowed": false,
  "symlink_escape_allowed": false,
  "streaming_hashes_only": true,
  "large_binary_full_load_allowed": false,
  "embeddings_allowed": false,
  "vector_db_allowed": false,
  "lancedb_allowed": false,
  "openusd_runtime_allowed": false,
  "source_file_mutation_allowed": false,
  "network_allowed": false,
  "browser_allowed": false,
  "provider_api_allowed": false,
  "credential_storage_allowed": false,
  "dcc_launch_allowed": false,
  "comfyui_launch_allowed": false,
  "production_autonomy_allowed": false,
  "required_event_metadata": [
    "scan_id",
    "root_id",
    "asset_count",
    "aggregate_inventory_hash",
    "per_asset_content_hash references or digests",
    "created_at",
    "previous_hash",
    "event_type"
  ]
}
