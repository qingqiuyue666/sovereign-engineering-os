{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:seos:v11-slice1:context_artifact",
  "artifact_type": "ContextArtifact",
  "schema_version": "v11-slice1",
  "source_ref": "v11 §23.4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_artifact_id",
    "task_id",
    "root_revision_id",
    "repo_graph_version",
    "symbol_index_version",
    "candidate_file_ids",
    "symbol_frontier_ids",
    "memory_item_ids",
    "packing_policy_version",
    "hard_budget_tokens",
    "effective_budget_tokens",
    "actual_tokens",
    "truncation_reason",
    "deferred_retrieval_items",
    "provenance_refs",
    "taint_set",
    "content_hash",
    "created_at",
    "version_tuple_hash"
  ],
  "properties": {
    "context_artifact_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "root_revision_id": {"type": "string", "minLength": 1},
    "repo_graph_version": {"type": "string"},
    "symbol_index_version": {"type": "string"},
    "candidate_file_ids": {"type": "array", "items": {"type": "string"}},
    "symbol_frontier_ids": {"type": "array", "items": {"type": "string"}},
    "memory_item_ids": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Phase-1 memory policy: MUST be empty. See foundation §3 item 11."
    },
    "packing_policy_version": {"type": "string"},
    "hard_budget_tokens": {"type": "integer", "minimum": 0},
    "effective_budget_tokens": {"type": "integer", "minimum": 0},
    "actual_tokens": {"type": "integer", "minimum": 0},
    "truncation_reason": {"type": ["string", "null"]},
    "deferred_retrieval_items": {"type": "array", "items": {"type": "string"}},
    "provenance_refs": {"type": "array", "items": {"type": "string"}},
    "taint_set": {"type": "array", "items": {"type": "string"}},
    "content_hash": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "version_tuple_hash": {"type": "string", "minLength": 1},
    "context_class": {"type": "string"},
    "replay_class_hint": {"type": "string"}
  }
}
