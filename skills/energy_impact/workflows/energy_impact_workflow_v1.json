{
  "edges": [
    {
      "from": "houdini_energy_smoke",
      "mode": "artifact_refs",
      "to": "comfyui_energy_image"
    },
    {
      "from": "comfyui_energy_image",
      "mode": "artifact_refs",
      "to": "davinci_energy_project_probe"
    }
  ],
  "failure_policy": {
    "rerun_from_failed_node": true,
    "stop_downstream_on_failure": true
  },
  "nodes": [
    {
      "action": "smoke_cache_test",
      "adapter": "houdini_hython",
      "node_id": "houdini_energy_smoke",
      "payload": {
        "cache_name": "energy_impact_001_smoke_cache"
      },
      "rpc_template": "skills/energy_impact/rpc_templates/houdini_smoke_cache_test.json"
    },
    {
      "action": "submit_workflow",
      "adapter": "comfyui_local",
      "node_id": "comfyui_energy_image",
      "payload": {
        "history_timeout_seconds": 30,
        "poll_interval_seconds": 1,
        "workflow_path": "examples/comfyui/workflows/minimal_save_image.json"
      },
      "rpc_template": "skills/energy_impact/rpc_templates/comfyui_submit_workflow.json"
    },
    {
      "action": "project_probe",
      "adapter": "davinci_resolve",
      "node_id": "davinci_energy_project_probe",
      "payload": {
        "project_name": ""
      },
      "rpc_template": "skills/energy_impact/rpc_templates/davinci_project_probe.json"
    }
  ],
  "schema_version": "seos.cross_software_workflow.v1",
  "workflow_id": "energy_impact_workflow_v1"
}
