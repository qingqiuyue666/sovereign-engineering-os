{
  "policy_type": "human_approval_token_v1",
  "version": 1,
  "purpose": "Create scoped, expiring, revocable human approval artifacts for risky dry-run/runtime actions.",
  "production_autonomy_allowed": false,
  "router_bypass_allowed": false,
  "tool_risk_classifier_bypass_allowed": false,
  "raw_command_allowed": false,
  "payload_argv_allowed": false,
  "command_line_allowed": false,
  "credential_storage_allowed": false,
  "implicit_credential_approval_allowed": false,
  "subprocess_allowed": false,
  "network_allowed": false,
  "browser_allowed": false,
  "provider_api_allowed": false,
  "dcc_launch_allowed": false,
  "comfyui_launch_allowed": false,
  "supported_action_types": [
    "READ_PATH",
    "WRITE_PATH",
    "LAUNCH_PROCESS",
    "CALL_MCP_TOOL",
    "RUN_COMFYUI",
    "RUN_DCC_APP",
    "RUN_MODEL",
    "RUN_PLUGIN",
    "ACCESS_NETWORK",
    "CALL_PROVIDER",
    "BROWSER_CONTROL",
    "MUTATE_ASSET",
    "OVERWRITE_ARTIFACT",
    "DELETE",
    "RELEASE",
    "DRY_RUN_COMMAND_ID"
  ],
  "required_token_fields": [
    "approval_id",
    "operator_id",
    "scope_id",
    "action_type",
    "target_id",
    "risk_class",
    "issued_at",
    "expires_at",
    "revoked",
    "reason",
    "content_hash"
  ],
  "required_decision_fields": [
    "approval_id",
    "accepted",
    "rejection_reason",
    "decided_at",
    "operator_id",
    "content_hash"
  ]
}
