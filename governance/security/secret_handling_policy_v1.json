{
  "policy_type": "seos_secret_handling_policy_v1",
  "version": "v1",
  "status": "active_contract",
  "scanner_engine": "CoreSecretScanner",
  "fail_closed": true,
  "read_only_gate": true,
  "max_text_chars": 200000,
  "max_file_bytes": 1048576,
  "max_scan_items": 1000,
  "fake_secret_marker_policy": {
    "marker": "SEOS_FAKE_SECRET_OK",
    "allowed_path_prefixes": ["tests/", "governance/security/fixtures/"],
    "deny_outside_allowed_paths": true
  },
  "blocked_labels": ["SECRET", "CROWN_JEWEL"],
  "blocked_field_names": ["api_key", "token", "password", "cookie", "authorization", "secret_value", "env_value", "private_key", "raw_prompt", "raw_provider_response"],
  "known_safe_hash_fields": ["git_blob_sha1", "sha256", "digest", "content_hash", "snapshot_root_hash", "output_hash", "root_commitment", "artifact_hash", "cross_phase_digest"],
  "network_accessed": false,
  "runtime_execution_performed": false,
  "secret_value_read": false,
  "secret_value_persisted": false
}
